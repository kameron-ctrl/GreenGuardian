# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# Base URL of the Green Guardian backend API (no trailing slash).
# Local dev with the FastAPI backend running via `uvicorn main:app`:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production example (set this as a GitHub Actions repository variable, not here):
# NEXT_PUBLIC_API_URL=https://<your-api-id>.execute-api.<region>.amazonaws.com/prod
