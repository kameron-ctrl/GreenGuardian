# Backend configuration. In production these are set as AWS Lambda environment
# variables, NOT committed. Copy to .env only for local runs if you wire up a
# loader; the app also reads them directly from the process environment.

# Comma-separated list of allowed CORS origins (your frontend URLs).
# Defaults to localhost dev origins when unset.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3411

# Max accepted upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# Best-effort in-process rate limit (real enforcement is at API Gateway).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
